#!/bin/sh
set -e

if [ "$1" = configure ]; then
    update-alternatives --remove internet-browser /usr/bin/nordstjernen \
        >/dev/null 2>&1 || true
    update-alternatives --install /usr/bin/open-browser-nordstjernen open-browser-nordstjernen \
        /usr/bin/nordstjernen 60
fi

#DEBHELPER#
