<services>
  <service name="tar_scm">
    <param name="scm">git</param>
    <param name="url">https://github.com/nordstjernen-web/nordstjernen.git</param>
    <param name="revision">main</param>
    <param name="version">1.14</param>
    <param name="versionformat">1.14</param>
    <param name="filename">nordstjernen</param>
  </service>
  <service name="recompress">
    <param name="file">nordstjernen-*.tar</param>
    <param name="compression">gz</param>
  </service>
  <service name="set_version"/>
</services>
